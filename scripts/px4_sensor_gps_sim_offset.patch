-		const double longitude = gpos.lon + math::degrees((double)_gps_pos_noise_e / CONSTANTS_RADIUS_OF_EARTH);
+		// Measurement offset applied to the published fix (SIM_SPF_*): drift ramps over 10 s to a constant rate,
+		// jump is a constant offset. Used only to study a receiver whose fixes are shifted; no RF is involved.
+		float spf_n = 0.f;
+		float spf_e = 0.f;
+		float spf_vn = 0.f;
+		float spf_ve = 0.f;
+
+		if (_param_spf_on.get() == 1) {
+			if (_spf_t0 == 0) {
+				_spf_t0 = hrt_absolute_time();
+			}
+
+			const float tau = (float)(hrt_absolute_time() - _spf_t0) * 1e-6f;
+			const float hdg = math::radians(_param_spf_hdg.get());
+			const float ux = cosf(hdg); // north
+			const float uy = sinf(hdg); // east
+			float dist = 0.f;
+			float rate = 0.f;
+
+			if (_param_spf_mode.get() == 1) {
+				dist = _param_spf_val.get();
+
+			} else {
+				const float ramp = 10.f;
+				const float r = _param_spf_val.get();
+				dist = tau < ramp ? 0.5f * r * tau * tau / ramp : 0.5f * r * ramp + r * (tau - ramp);
+				rate = r * math::min(tau / ramp, 1.f);
+			}
+
+			spf_n = dist * ux;
+			spf_e = dist * uy;
+
+			if (_param_spf_vel.get() == 1) {
+				spf_vn = rate * ux;
+				spf_ve = rate * uy;
+			}
+
+		} else {
+			_spf_t0 = 0;
+		}
+
+		const double latitude = gpos.lat + math::degrees((double)(_gps_pos_noise_n + spf_n) / CONSTANTS_RADIUS_OF_EARTH);
+		const double longitude = gpos.lon + math::degrees((double)_gps_pos_noise_e / CONSTANTS_RADIUS_OF_EARTH)
+					 + math::degrees((double)spf_e / CONSTANTS_RADIUS_OF_EARTH) / cos(math::radians(gpos.lat));
 		const double altitude = (double)(gpos.alt + _gps_pos_noise_d);
 
 		_gps_vel_noise_n = _vel_markov_time * _gps_vel_noise_n +
@@ -142,7 +184,7 @@ void SensorGpsSim::Run()
 		_gps_vel_noise_d = _vel_markov_time * _gps_vel_noise_d +
 				   _vel_noise_density * generate_wgn() * _vel_noise_amplitude * 1.2f;
 
-		const Vector3f gps_vel = Vector3f{lpos.vx + _gps_vel_noise_n, lpos.vy + _gps_vel_noise_e, lpos.vz + _gps_vel_noise_d};
+		const Vector3f gps_vel = Vector3f{lpos.vx + _gps_vel_noise_n + spf_vn, lpos.vy + _gps_vel_noise_e + spf_ve, lpos.vz + _gps_vel_noise_d};
 
 		// device id
 		device::Device::DeviceId device_id;
